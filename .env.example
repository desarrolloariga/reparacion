# ─────────────────────────────────────────────────────────────
# ARIGA JOYERÍA · variables de entorno
# Copia este archivo a .env.local y llena los valores.
# .env.local NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave de servicio. Es la ÚNICA credencial con la que la aplicación habla
# con la base: el esquema `joyeria` está cerrado a los roles públicos.
# Nunca la prefijes con NEXT_PUBLIC_ ni la uses desde un componente cliente.
# En Vercel debe marcarse como "Sensitive".
SUPABASE_SERVICE_ROLE_KEY=

# Clave pública (publishable). Hoy la app no la usa: todo pasa por el
# servidor. Queda lista por si se usa Supabase Auth desde el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Conexión directa a Postgres (Dashboard → Connect → Session pooler, IPv4).
# Solo la usan los scripts locales: db:push, db:types, db:sql. NUNCA en Vercel.
# La contraseña va percent-encoded (por ejemplo `*` → %2A).
SUPABASE_DB_URL=postgresql://postgres.TU-PROYECTO:CONTRASENA@aws-1-REGION.pooler.supabase.com:5432/postgres

# Secreto de los jobs programados. Vercel Cron lo manda como
# `Authorization: Bearer <CRON_SECRET>`. Generar uno largo y aleatorio.
CRON_SECRET=

# Bucket privado de Storage para fotografías y diseños (npm run storage:preparar).
SUPABASE_STORAGE_BUCKET=reparaciones

# URL pública del sitio. En producción, el dominio real de Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# El esquema de Postgres (`joyeria`) es una constante en
# src/lib/supabase/env.ts, no una variable de entorno: forma parte de los
# tipos que genera `npm run db:types`.
